APP_NAME="Alpha Gaming Shop"
APP_ENV=production
APP_KEY=base64:AlphaGamingSecretKey987654321000000000000=
APP_DEBUG=false

# Application URL
# Local Development: http://localhost:8000
# Production on Render: https://alpha-efxl.onrender.com
APP_URL=http://localhost:8000

# Google OAuth 2.0 Credentials
# Get your Client ID and Secret from: https://console.cloud.google.com/apis/credentials
# Local Authorized Redirect URI: http://localhost:8000/auth/google/callback
# Production Authorized Redirect URI: https://alpha-efxl.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration (supports sqlite or mysql)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/data/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@alphagaming.store"
MAIL_FROM_NAME="Alpha Gaming Shop"