APP_NAME="ALPHA GAMING SHOP"
APP_ENV=production
APP_KEY=base64:AlphaGamingSecretKey987654321000000000000=
APP_DEBUG=false

# Application URL
# Local Development: http://localhost:8000
# Production on Render: https://alpha-efxl.onrender.com
APP_URL=https://alpha-efxl.onrender.com

# Database Configuration (supports sqlite or mysql/tidb)
# Default for local development: sqlite
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/data/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
# Or single connection URL (e.g. from TiDB Cloud or Render):
# DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/alpha_gaming

# Cloudinary Object Storage (For permanent product images on Render)
# Free registration at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or single URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Real Production SMTP Configuration (Gmail SMTP)
# Note: For Gmail, use a Google App Password (16 letters generated from Google Account Security), NOT your normal account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=YOUR_GMAIL@gmail.com
MAIL_FROM_NAME="ALPHA GAMING SHOP"

# Google OAuth 2.0 Credentials (Optional)
# Get your Client ID and Secret from: https://console.cloud.google.com/apis/credentials
# Local Redirect URI: http://localhost:8000/auth/google/callback
# Production (Render) Redirect URI: https://alpha-efxl.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=