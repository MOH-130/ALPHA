APP_NAME="NovaStore Pro"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-store.vercel.app

# Database - SQLite works on Vercel without external DB
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_store
DB_USERNAME=root
DB_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@novastore.com"
MAIL_FROM_NAME="${APP_NAME}"