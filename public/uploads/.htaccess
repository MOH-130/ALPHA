# Disable script execution inside uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny access to any non-media files
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|jsp|asp|htm|html|shtml|sh|cgi|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI

# Anti-Hotlinking Protection for uploaded assets
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Allow direct requests or empty referrers
    RewriteCond %{HTTP_REFERER} !^$ [NC]
    # Allow local development
    RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:[0-9]+)? [NC]
    # Allow production domain and Render domains
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?onrender\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?alpha-gaming\.shop [NC]
    # Allow search engines & social network preview crawlers
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?google\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?bing\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?facebook\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?instagram\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?whatsapp\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?discord\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?t\.me [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?twitter\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-zA-Z0-9-]+\.)?x\.com [NC]
    # Deny unauthorized external hotlinking
    RewriteRule \.(jpe?g|png|gif|webp|svg|ico)$ - [F,NC]
</IfModule>
