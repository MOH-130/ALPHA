# Disable script execution inside uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny access to any non-media files
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|jsp|asp|htm|html|shtml|sh|cgi|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI
