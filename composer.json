{
    "name": "novastore/ecommerce-platform",
    "type": "project",
    "description": "Professional Full-Stack E-Commerce Platform with Admin Dashboard, Multi-language, Multi-currency, and Payments",
    "keywords": ["laravel", "ecommerce", "admin", "store", "php"],
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Core/Helper.php"
        ]
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
